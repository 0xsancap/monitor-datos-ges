# Copia este fichero a .env y rellénalo. .env no se sube a git.

# ── Grafana ──────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esto
# URL con la que se abre Grafana desde la red interna (aparece en los emails)
GRAFANA_ROOT_URL=http://monitor.interno:3000

# ── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.empresa.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=monitor@empresa.com
# Destinatarios de las alertas, separados por ";"
ALERT_EMAILS=sistemas@empresa.com

# ── MySQL / Cloud SQL (usuario de solo lectura) ──────────
MYSQL_PRIMARY_HOST=10.0.0.5:3306
MYSQL_REPLICA_HOST=10.0.0.6:3306
MYSQL_DB=negocio
MYSQL_MONITOR_USER=monitor
MYSQL_MONITOR_PASSWORD=

# ── GCP ──────────────────────────────────────────────────
GCP_PROJECT_ID=mi-proyecto
# Activa el exportador de Cloud Monitoring (replication lag)
COMPOSE_PROFILES=gcp

# ── SAP PO (solo si el exportador corre en esta VM; añade "sappo" a COMPOSE_PROFILES) ──
# Si el exportador va en Azure, su configuración está en sappo_exporter/.env
SAPPO_URL=http://10.1.0.20:50000
SAPPO_USUARIO=PIMONITOR
SAPPO_PASSWORD=
SAPPO_VERIFICAR_TLS=true
# Contraseña de /metrics; la misma va en prometheus/secrets/sappo_password
SAPPO_METRICS_PASSWORD=
