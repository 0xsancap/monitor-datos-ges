# SAP PO con el exportador en la misma VM que el monitor (hay VPN GCP ↔ Azure).
# Para activarlo:
#   cp prometheus/scrape.d/sappo-local.yml.example prometheus/scrape.d/sappo.yml
#   echo -n "$SAPPO_METRICS_PASSWORD" > prometheus/secrets/sappo_password
#   añade "sappo" a COMPOSE_PROFILES en .env y: docker compose up -d
scrape_configs:
  - job_name: sappo
    scrape_timeout: 20s
    basic_auth:
      username: monitor
      password_file: /etc/prometheus/secrets/sappo_password
    static_configs:
      - targets: ["sappo-exporter:9105"]
