# Copia a .env y rellena. .env no se sube a git.

# ── SAP PO ───────────────────────────────────────────────
SAPPO_MODO=soap
# Host y puerto HTTP(S) del AS Java de PO, sin ruta (normalmente 5XX00 / 5XX01)
SAPPO_URL=http://10.1.0.20:50000
SAPPO_USUARIO=PIMONITOR
SAPPO_PASSWORD=
# false solo si PO usa un certificado interno que no se puede validar
SAPPO_VERIFICAR_TLS=true

# Estados a vigilar (toBeDelivered = "Scheduled" en el monitor de PO)
SAPPO_ESTADOS=systemError,toBeDelivered,holding,waiting
# Días hacia atrás que se consultan
SAPPO_VENTANA_DIAS=7
# Un error cuenta como "nuevo" durante estos minutos
SAPPO_ERRORES_NUEVOS_MIN=15
# Segundos entre consultas a PO
SAPPO_INTERVALO=60
# Máximo de mensajes por estado y consulta (si se alcanza, sappo_resultado_truncado = 1)
SAPPO_MAX_MENSAJES=5000

# ── /metrics (lo que usa Prometheus para leer) ──────────
METRICS_USUARIO=monitor
# Contraseña larga y aleatoria: openssl rand -base64 24
METRICS_PASSWORD=
