    {
      "type": "table",
      "id": 8,
      "title": "Consultas en ejecución · principal (en vivo)",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "mysql-primary"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql-primary"
          },
          "rawSql": "SELECT ID AS id, USER AS usuario, HOST AS host, DB AS bd, COMMAND AS comando,\n       TIME AS segundos, STATE AS estado, LEFT(INFO, 500) AS consulta\n  FROM information_schema.PROCESSLIST\n WHERE COMMAND NOT IN ('Sleep', 'Binlog Dump', 'Binlog Dump GTID', 'Daemon')\n   AND ID <> CONNECTION_ID()\n ORDER BY TIME DESC\n LIMIT 50",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "segundos"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
