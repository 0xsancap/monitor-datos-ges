        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "cloudsql_replica_lag_seconds or on() vector(-1)",
          "legendFormat": "{{database_id}}",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
